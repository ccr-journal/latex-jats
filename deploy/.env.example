# Configuration for the JATSmith web service.
#
# These defaults run a working local install at http://localhost.
# Just `docker compose up -d` and log in as: editor / devpass
#
# Before deploying publicly:
#   - change EDITOR_CREDENTIALS to a real password
#   - set SITE_ADDRESS to your bare domain (Caddy will handle TLS)
#   - configure OJS_* if you import submissions from OJS
# Then: docker compose up -d --force-recreate

# ── Editor login (required) ───────────────────────────────────────────────────

# Username:password pairs for editor logins. Two formats:
#   - plain string → single user "editor" with that password
#   - pairs:        user1:pw1,user2:pw2
# Rotate by updating this value and restarting the stack.
EDITOR_CREDENTIALS=editor:devpass

# ── Public address ────────────────────────────────────────────────────────────

# What Caddy serves on. Two shapes:
#   - URL with scheme (e.g. "http://localhost") → Caddy uses it verbatim, no
#     auto-TLS. Right for a local trial: no self-signed-cert browser prompt.
#   - bare hostname (e.g. "jats.example.com")  → Caddy enables auto-TLS via
#     Let's Encrypt. Right for a public deploy.
# The api container also reads this to derive the URL it embeds in
# author-invite emails.
SITE_ADDRESS=http://localhost

# Host ports mapped by docker-compose. Override if 80/443 are already in use.
# HTTP_PORT=80
# HTTPS_PORT=443

# Override only when the public URL of the SPA differs from what's derived
# from SITE_ADDRESS — e.g. behind a reverse proxy that terminates TLS on a
# different host. Used to build the per-manuscript author-invite URL.
# FRONTEND_URL=https://jats.example.com

# ── OJS (optional) ────────────────────────────────────────────────────────────

# Set OJS_ADMIN_TOKEN to enable importing submissions from OJS. The token,
# base URL, and journal path travel together — without the token the URL
# and path are useless, so all three live here in env vars. The DOI prefix
# lives in the SiteConfig table (it's also used in JATS journal-meta).
#
# Generate the admin token via OJS Profile → API Key; use a dedicated
# service account so rotation doesn't break on role changes.
#
# OJS_BASE_URL=https://journal.example.com
# OJS_JOURNAL_PATH=your-journal-path
# OJS_ADMIN_TOKEN=...

# ── Claude diagnosis (optional) ───────────────────────────────────────────────

# Set ANTHROPIC_API_KEY to enable the "Ask Claude" panel on the manuscript
# page. Authors and editors can ask Claude (Sonnet 4.6) to diagnose
# conversion failures or output issues; chats are persisted per manuscript.
# Without this set, /api/auth/me reports claude_api_enabled: false and the
# panel is hidden. Get a key at https://platform.claude.com/settings/keys.
# Expected cost: ~$0.10 per diagnosis on average; rate-limited to 5 user
# messages per manuscript per day.
#
# ANTHROPIC_API_KEY=sk-ant-...

# ── Sessions ──────────────────────────────────────────────────────────────────

# How long an issued session token is valid (default 30 days).
# SESSION_TOKEN_TTL_DAYS=30
