# Configuration for the JATSmith web service.
#
# These defaults run a working local install at https://localhost.
# Just `docker compose up -d` and log in as: editor / devpass
# (Caddy serves a local-CA cert; your browser may prompt to trust it.)
#
# Before deploying publicly:
#   - change EDITOR_CREDENTIALS to a real password
#   - set SITE_ADDRESS to your domain (uncomment below)
#   - configure OJS_* if you import submissions from OJS
# Then: docker compose up -d --force-recreate

# ── Editor login (required) ───────────────────────────────────────────────────

# Username:password pairs for editor logins. Two formats:
#   - plain string → single user "editor" with that password
#   - pairs:        user1:pw1,user2:pw2
# Rotate by updating this value and restarting the stack.
EDITOR_CREDENTIALS=editor:devpass

# ── Public address ────────────────────────────────────────────────────────────

# Hostname Caddy serves on (bare domain, no scheme). The api container also
# uses this to derive the URL it embeds in author-invite emails.
# For a public deploy, change to your domain (e.g. jats.example.com); Caddy
# then handles TLS automatically.
SITE_ADDRESS=localhost

# Host ports mapped by docker-compose. Override if 80/443 are already in use.
# HTTP_PORT=80
# HTTPS_PORT=443

# Override only if the public URL of the SPA differs from `https://{SITE_ADDRESS}`
# — e.g. when behind a reverse proxy that terminates TLS on a different host.
# Used to build the per-manuscript author-invite URL emailed to authors.
# FRONTEND_URL=https://jats.example.com

# ── OJS (optional) ────────────────────────────────────────────────────────────

# Set OJS_ADMIN_TOKEN to enable importing submissions from OJS. The token,
# base URL, and journal path travel together — without the token the URL
# and path are useless, so all three live here in env vars. The DOI prefix
# lives in the SiteConfig table (it's also used in JATS journal-meta).
#
# Generate the admin token via OJS Profile → API Key; use a dedicated
# service account so rotation doesn't break on role changes.
#
# OJS_BASE_URL=https://journal.example.com
# OJS_JOURNAL_PATH=your-journal-path
# OJS_ADMIN_TOKEN=...

# ── Sessions ──────────────────────────────────────────────────────────────────

# How long an issued session token is valid (default 30 days).
# SESSION_TOKEN_TTL_DAYS=30
