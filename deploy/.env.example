# Configuration for the JATSmith web service.
# Copy this file to .env and fill in the required values.

# ── Deployment ────────────────────────────────────────────────────────────────

# Public hostname Caddy serves on. Bare domain (no scheme). Use "localhost"
# (the default) to run the stack locally without TLS.
SITE_ADDRESS=jats.example.com

# Host ports mapped by docker-compose. Leave as-is unless another service
# already occupies 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# ── Editor login (required) ───────────────────────────────────────────────────

# Username:password pairs for editor logins. Two formats:
#   - plain string → single user "editor" with that password
#   - pairs: user1:pw1,user2:pw2
# Rotate by updating this value and restarting the stack.
EDITOR_CREDENTIALS=change-me

# Optional — defaults to https://{SITE_ADDRESS}. Used to redirect back to
# the SPA after login.
# FRONTEND_URL=https://jats.example.com

# ── OJS (required for importing submissions) ──────────────────────────────────

# Token, base URL, and journal path travel together — without the admin token
# the URL and path are useless, so all three live here. The DOI prefix lives
# in the SiteConfig table (it's also used in JATS journal-meta).
# Generate the admin token on the OJS admin profile (Profile → API Key); use
# a dedicated service account so rotation doesn't break on role changes.
OJS_BASE_URL=https://journal.computationalcommunication.org
OJS_JOURNAL_PATH=ccr
OJS_ADMIN_TOKEN=change-me

# ── Sessions ──────────────────────────────────────────────────────────────────

# How long an issued session token is valid.
# SESSION_TOKEN_TTL_DAYS=30
